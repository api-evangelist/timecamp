                "type": "path",
                "description": "task id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint updates value or creates new rate for given `rateTypeId` and `task_id`."
        },
