        {
          "id": "5aa9eee5-6c7f-4ae3-82d2-8acffde114aa",
          "name": "Detach a tag list from a task",
          "request": {
            "name": "Detach a tag list from a task",
            "description": {
              "content": "Idempotent deletion of the direct assignment row between a tag list and a task in `tc_tt_task_tag_lists`. Only the row with `task_id = taskId` is deleted; rows on ancestor tasks remain untouched, so an inherited tag list will still be visible via `getForTask` after this operation. Returns `204 No Content` even when no direct row existed (mirrors legacy `TtModel::removeTagList`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "task",
                ":taskId",
                "tag-list",
                ":tagListId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "taskId",
                  "description": "(Required) Task ID the tag list assignment relates to."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "tagListId",
                  "description": "(Required) Tag list ID being assigned to or detached from the task."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
