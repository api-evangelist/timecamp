            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Storage get file"
        },
        {
          "info": {
            "name": "Get the list of files from the user's main group",
            "type": "http"
