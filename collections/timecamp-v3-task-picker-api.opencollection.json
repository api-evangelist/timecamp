      "info": {
        "name": "[v3] Task Picker",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List of favorite tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.timecamp.com/third_party/api/v3/taskPicker/favourites",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List of favorite tasks"
        },
        {
          "info": {
            "name": "Add task to favorite tasks list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.timecamp.com/third_party/api/v3/taskPicker/favourites/add/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add task to favorite tasks list"
        },
        {
          "info": {
            "name": "Delete task from favorite tasks list",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.timecamp.com/third_party/api/v3/taskPicker/favourites/delete/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete task from favorite tasks list"
        }
      ]
    }
  ],
  "bundled": true
