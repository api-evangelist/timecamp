        {
          "info": {
            "name": "Get logged time in a week",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.timecamp.com/third_party/api/logged_time_in_week",
            "params": [
              {
                "name": "day",
                "value": "",
                "type": "query",
                "description": "day in `YYYY-MM-DD` format"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint gets a `day` and returns array with summarized entries time per day for this week. The time is returned in seconds."
        }
