{
  "opencollection": "1.0.0",
  "info": {
    "name": "TimeCamp [v1] Approvals [v1] Approvals [v1] User API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "[v1] User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all users data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.timecamp.com/third_party/api/users",
            "params": [
              {
                "name": "active_only",
                "value": "",
                "type": "query",
                "description": "If true returns only active users"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves information about all users in an account"
        },
        {
          "info": {
            "name": "Get user setting",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.timecamp.com/third_party/api/user/:user_id/setting",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "user id"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "setting name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return user's setting value."
        },
        {
          "info": {
            "name": "Update user setting",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.timecamp.com/third_party/api/user/:user_id/setting",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "user id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update user setting."
        },
        {
          "info": {
            "name": "Delete user setting",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.timecamp.com/third_party/api/user/:user_id/setting",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "user id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete user setting."
        },
        {
          "info": {
            "name": "Get your user data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.timecamp.com/third_party/api/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get your user data."
        },
        {
          "info": {
            "name": "Update user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.timecamp.com/third_party/api/user",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update user's data. If `user_id` is not provided, the data for the user associated with the API key will be updated.\n"
        },
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.timecamp.com/third_party/api/user/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "user id"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns user's information. If `user_id` is not provided then returns current user data. Provide comma separated ids for multiple users ie. `132,423,456`."
        }
      ]
    }
  ],
  "bundled": true
}