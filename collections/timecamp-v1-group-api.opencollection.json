              {
                "name": "group_id",
                "value": "",
                "type": "path",
                "description": "group id"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "name of setting to get"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns setting for given group_id."
        },
