  },
  "items": [
    {
      "info": {
        "name": "[v1] Group",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.timecamp.com/third_party/api/group",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all groups."
        },
        {
          "info": {
            "name": "Update group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.timecamp.com/third_party/api/group",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Modify existing group. Edit permission is required.\n\nWARNING: backend might not return a response, but changes will be applied!"
        },
        {
          "info": {
            "name": "Create group",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.timecamp.com/third_party/api/group",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add new group. Edit permission is required.\n\n\nThere cannot be more than one root group (with parent_id = 0).\nMaximum group tree depth is 4 levels.\n\nIf you get an error 403 `You can not change this group` try to wait about one minute and retry."
        },
        {
          "info": {
            "name": "Delete group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.timecamp.com/third_party/api/group",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a group. Edit permission is required.\n\nRoot Group (`parent_id == 0`) cannot be deleted.\n\nAll subgroups of deleted group have their `parent_id` changed to `root_group_id`.\n\n\nWARNING: backend might not return a response, but changes will be applied!"
        },
        {
          "info": {
            "name": "Get group setting",
            "type": "http"
